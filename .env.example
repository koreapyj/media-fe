# Copy to `.env` to override defaults. Build-time config (Vite). All keys are OPTIONAL.

# URL of the M3U playlist (its #EXTM3U `url-tvg` attribute supplies the EPG URL).
# Default when unset: `channels.m3u` served next to the app, i.e. /<prefix>/channels.m3u
# VITE_PLAYLIST_URL=https://example.com/playlist.m3u

# Optional: override the EPG (XMLTV) URL instead of using the playlist's url-tvg.
# VITE_EPG_URL=https://example.com/epg.xml
