# Copy to `.env` to override defaults. Build-time config (Vite). All keys are OPTIONAL.

# URL of the JSON manifest listing the playlists to load. Each playlist supplies its own EPG
# via its #EXTM3U `url-tvg`. Manifest shape: { "playlists": ["a.m3u", "b.m3u"] }
# Default when unset: `config.json` served next to the app, i.e. /<prefix>/config.json
# VITE_CONFIG_URL=https://example.com/config.json
